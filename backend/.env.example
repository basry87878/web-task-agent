# Copy this file to .env and fill in your real API keys.
# Never commit .env to version control.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional model & guardrail overrides
# GEMINI_PRIMARY_MODEL=gemini-4-hydrogen
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# GROQ_SECONDARY_FALLBACK_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# MAX_RESEARCH_RUNS_PER_SESSION=20

# Deep Research providers (strictly separate from Fast Mode / Tavily)
# GOOGLE_API_KEY=your_google_gemini_api_key_here
# SERPER_API_KEY=your_serper_api_key_here
# EXA_API_KEY=your_exa_api_key_here
# SERPAPI_API_KEY=your_serpapi_api_key_here
# DATAFORSEO_LOGIN=your_dataforseo_login
# DATAFORSEO_PASSWORD=your_dataforseo_password
# BRIGHTDATA_API_KEY=your_brightdata_api_key_here
# BRIGHTDATA_SERP_ZONE=your_brightdata_serp_zone
# SCRAPFLY_API_KEY=your_scrapfly_api_key_here
# APIFY=your_apify_token_here

# Optional Google Analytics 4 (leave unset to disable)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_API_SECRET=your_ga4_measurement_protocol_secret

# Optional extra CORS origins (comma-separated)
# CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
