# Copy this file to .env and fill in your real API keys.
# Never commit .env to version control.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides
# GEMINI_PRIMARY_MODEL=gemini-4-hydrogen
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# OPENROUTER_MODEL=openrouter/free
# MAX_CUSTOM_RUNS_PER_SESSION=15
# MAX_COACH_MESSAGES_PER_SESSION=10

# Optional Google Analytics 4 (leave unset to disable)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_API_SECRET=your_ga4_measurement_protocol_secret
